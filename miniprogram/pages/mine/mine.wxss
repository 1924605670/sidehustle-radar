.mine-page {
  padding-top: 18rpx;
}

.tool-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.tool-card {
  min-height: 138rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e4e9f2;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.tool-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.plain-tag {
  margin: 0;
}
