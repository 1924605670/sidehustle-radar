.result-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 20rpx;
}

.result-score {
  color: #ffffff;
  font-size: 86rpx;
  font-weight: 800;
  line-height: 1;
}

.decision-card {
  margin-top: 20rpx;
  padding: 20rpx;
  border-radius: 14rpx;
  background: rgba(255, 255, 255, 0.1);
  border: 1rpx solid rgba(255, 255, 255, 0.13);
}

.decision-card.high,
.decision-card.extreme {
  background: rgba(255, 241, 240, 0.12);
}

.decision-card.low {
  background: rgba(236, 253, 243, 0.12);
}

.decision-title {
  color: #ffffff;
  font-size: 31rpx;
  font-weight: 800;
  line-height: 1.35;
}

.decision-copy {
  margin-top: 10rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 24rpx;
  line-height: 1.5;
}

.result-context {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.result-context text {
  padding: 8rpx 14rpx;
  border-radius: 10rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.evidence-line {
  display: flex;
  align-items: flex-start;
  padding: 14rpx 0;
  color: #344054;
  font-size: 26rpx;
  line-height: 1.5;
  border-bottom: 1rpx solid #edf1f7;
}

.evidence-line:last-child {
  border-bottom: 0;
}

.evidence-dot {
  width: 14rpx;
  height: 14rpx;
  margin: 12rpx 14rpx 0 0;
  border-radius: 50%;
  background: #f79009;
  flex: 0 0 14rpx;
}

.ai-panel {
  border-color: #c7e7df;
}

.priority-panel {
  border-color: #c7e7df;
}

.why-title {
  margin-top: 26rpx;
}

.ai-summary {
  color: #101828;
  font-size: 29rpx;
  font-weight: 700;
  line-height: 1.45;
}

.rule-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.rule-card:last-child {
  border-bottom: 0;
}

.rule-keyword {
  color: #b42318;
  font-size: 27rpx;
  font-weight: 700;
}

.share-button {
  padding: 0;
  margin: 0;
  line-height: normal;
  border: 0;
}

.share-button::after {
  border: 0;
}
