<view class="page">
  <view class="panel">
    <view class="title">风险分：{{result.risk_score}}</view>
    <view class="risk-{{result.risk_level}}" style="font-size:34rpx;font-weight:700;margin-top:12rpx;">{{result.risk_level_text}}</view>
    <view class="subtitle">{{result.possible_pattern}}</view>
  </view>

  <view class="panel">
    <view style="font-weight:700;">命中可疑点</view>
    <block wx:for="{{result.hit_rules}}" wx:key="id">
      <view class="subtitle">- {{item.keyword}}：{{item.explanation}}</view>
    </block>
  </view>

  <view class="panel">
    <view style="font-weight:700;">建议动作</view>
    <block wx:for="{{result.suggested_actions}}" wx:key="*this">
      <view class="subtitle">- {{item}}</view>
    </block>
  </view>
</view>
