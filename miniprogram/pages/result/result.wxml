<view class="page">
  <block wx:if="{{!hasResult}}">
    <view class="panel">
      <view class="empty-state">还没有检测结果。请先粘贴一段副业文案进行检测。</view>
      <view class="primary-button" bindtap="goScan">去检测</view>
    </view>
  </block>

  <block wx:else>
    <view class="hero-panel">
      <view class="eyebrow">检测结果</view>
      <view class="result-top">
        <view>
          <view class="result-score">{{result.risk_score}}</view>
          <view class="muted">风险分</view>
        </view>
        <view class="risk-pill {{result.risk_class}}">{{result.risk_level_text}}</view>
      </view>
      <view class="decision-card {{result.decision_tone}}">
        <view class="decision-title">{{result.decision_title}}</view>
        <view class="decision-copy">{{result.possible_pattern}}</view>
      </view>
      <view class="result-context">
        <text>{{result.input_mode_text}}</text>
        <text>{{result.source_platform_text}}</text>
        <text wx:if="{{result.project_name}}">{{result.project_name}}</text>
      </view>
    </view>

    <view class="panel priority-panel">
      <view class="section-title">下一步先做什么</view>
      <block wx:for="{{result.primary_actions}}" wx:key="*this">
        <view class="action-line">
          <view class="action-bullet"></view>
          <view>{{item}}</view>
        </view>
      </block>
      <view class="button-row tight-row">
        <view class="secondary-button" bindtap="goScan">再测一段</view>
        <view class="ghost-button" bindtap="copyConclusion">复制结论</view>
      </view>
      <view class="button-row tight-row">
        <button class="secondary-button share-button" open-type="share">发给朋友判断</button>
        <view class="ghost-button" bindtap="markInaccurate">判断不准</view>
      </view>
    </view>

    <view class="panel soft-panel" wx:if="{{result.primary_questions.length}}">
      <view class="section-title">继续前先问清楚</view>
      <block wx:for="{{result.primary_questions}}" wx:key="*this">
        <view class="list-line">
          <view class="list-index">{{index + 1}}</view>
          <view>{{item}}</view>
        </view>
      </block>
    </view>

    <view class="panel" wx:if="{{result.matched_projects.length}}">
      <view class="section-title">可继续核验的项目</view>
      <block wx:for="{{result.matched_projects}}" wx:key="id">
        <view class="project-card" data-slug="{{item.slug}}" bindtap="openProject">
          <view class="card-head">
            <view class="card-title">{{item.title}}</view>
            <view class="risk-pill {{item.risk_class}}">{{item.risk_level_text}}</view>
          </view>
          <view class="subtitle">{{item.summary}}</view>
          <view class="card-action">查看项目档案</view>
        </view>
      </block>
      <view class="button-row tight-row">
        <view class="ghost-button" bindtap="goProjects">查完整项目库</view>
      </view>
    </view>

    <view class="section-title why-title">为什么这么判</view>

    <view class="panel" wx:if="{{result.selected_signal_phrases.length}}">
      <view class="section-title">你勾选的红线</view>
      <block wx:for="{{result.selected_signal_phrases}}" wx:key="*this">
        <view class="evidence-line">
          <view class="evidence-dot"></view>
          <view>{{item}}</view>
        </view>
      </block>
    </view>

    <view class="panel ai-panel" wx:if="{{result.has_llm_analysis}}">
      <view class="section-title">
        <text>AI 语义分析</text>
        <text class="muted">规则结果不被 AI 降级</text>
      </view>
      <view class="ai-summary">{{result.llm_analysis.summary}}</view>
      <view class="subtitle">{{result.llm_analysis.risk_mechanism}}</view>
      <view wx:if="{{result.llm_analysis.extra_risk_points.length}}">
        <block wx:for="{{result.llm_analysis.extra_risk_points}}" wx:key="*this">
          <view class="tag danger">{{item}}</view>
        </block>
      </view>
    </view>

    <view class="section-block" wx:if="{{result.related_cases.length}}">
      <view class="section-title">风险证据链</view>
      <block wx:for="{{result.related_cases}}" wx:key="id">
        <view class="case-card">
          <view class="card-title">{{item.title}}</view>
          <view class="meta-row">
            <text>{{item.source_label}}</text>
          </view>
          <view class="subtitle">{{item.summary}}</view>
          <view class="notice" wx:if="{{item.loss_or_consequence}}">{{item.loss_or_consequence}}</view>
          <view>
            <block wx:for="{{item.risk_points_preview}}" wx:key="*this">
              <view class="tag danger">{{item}}</view>
            </block>
          </view>
          <view class="source-copy" data-url="{{item.source_url}}" bindtap="copySource">复制公开来源链接</view>
        </view>
      </block>
    </view>

    <view class="panel">
      <view class="section-title">命中可疑点</view>
      <block wx:for="{{result.hit_rules}}" wx:key="id">
        <view class="rule-card">
          <view class="rule-keyword">{{item.keyword}}</view>
          <view class="subtitle">{{item.explanation}}</view>
        </view>
      </block>
      <view wx:if="{{!result.hit_rules.length}}" class="empty-state">暂未命中明显高危词，但仍需核实主体、结算和是否先付费。</view>
    </view>
  </block>
</view>
