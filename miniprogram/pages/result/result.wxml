<view class="page">
  <block wx:if="{{!hasResult}}">
    <view class="panel">
      <view class="empty-state">还没有检测结果。请先粘贴一段副业文案进行检测。</view>
      <view class="primary-button" bindtap="goScan">去检测</view>
    </view>
  </block>

  <block wx:else>
    <view class="hero-panel">
      <view class="eyebrow">检测结果</view>
      <view class="result-score">{{result.risk_score}}</view>
      <view class="result-meta">
        <view class="risk-pill {{result.risk_class}}">{{result.risk_level_text}}</view>
        <view class="muted">{{result.possible_pattern}}</view>
      </view>
    </view>

    <view class="section-block" wx:if="{{result.related_cases.length}}">
      <view class="section-title">相似真实案例</view>
      <block wx:for="{{result.related_cases}}" wx:key="id">
        <view class="case-card">
          <view class="card-title">{{item.title}}</view>
          <view class="meta-row">
            <text>{{item.source_label}}</text>
          </view>
          <view class="subtitle">{{item.summary}}</view>
          <view class="notice" wx:if="{{item.loss_or_consequence}}">{{item.loss_or_consequence}}</view>
          <view>
            <block wx:for="{{item.risk_points_preview}}" wx:key="*this">
              <view class="tag danger">{{item}}</view>
            </block>
          </view>
          <view class="source-copy" data-url="{{item.source_url}}" bindtap="copySource">复制公开来源链接</view>
        </view>
      </block>
    </view>

    <view class="panel">
      <view class="section-title">命中可疑点</view>
      <block wx:for="{{result.hit_rules}}" wx:key="id">
        <view class="rule-card">
          <view class="rule-keyword">{{item.keyword}}</view>
          <view class="subtitle">{{item.explanation}}</view>
        </view>
      </block>
      <view wx:if="{{!result.hit_rules.length}}" class="empty-state">暂未命中明显高危词，但仍需核实主体、结算和是否先付费。</view>
    </view>

    <view class="panel">
      <view class="section-title">建议动作</view>
      <block wx:for="{{result.suggested_actions}}" wx:key="*this">
        <view class="list-line">
          <view class="list-index">{{index + 1}}</view>
          <view>{{item}}</view>
        </view>
      </block>
    </view>

    <view class="panel">
      <view class="section-title">核验问题</view>
      <block wx:for="{{result.questions_to_verify}}" wx:key="*this">
        <view class="list-line">
          <view class="list-index">{{index + 1}}</view>
          <view>{{item}}</view>
        </view>
      </block>
    </view>
  </block>
</view>
