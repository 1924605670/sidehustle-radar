.scan-page {
  padding-top: 18rpx;
}

.scan-hero {
  display: flex;
  min-height: 270rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  border-radius: 18rpx;
  background: #102a43;
  color: #ffffff;
  overflow: hidden;
  box-sizing: border-box;
  border: 1rpx solid rgba(255, 255, 255, 0.14);
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
  z-index: 1;
}

.hero-title {
  max-width: 430rpx;
  font-size: 38rpx;
  font-weight: 800;
  line-height: 1.24;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.55;
}

.hero-image {
  width: 210rpx;
  height: 210rpx;
  align-self: center;
  flex: 0 0 210rpx;
  border-radius: 18rpx;
  opacity: 0.96;
}

.segmented {
  display: flex;
  padding: 6rpx;
  margin-bottom: 24rpx;
  border-radius: 14rpx;
  background: #eef3f8;
}

.segmented-item {
  flex: 1;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 10rpx;
  color: #475467;
  font-size: 25rpx;
  font-weight: 700;
}

.segmented-item.active {
  background: #ffffff;
  color: #0f766e;
  box-shadow: 0 8rpx 18rpx rgba(15, 23, 42, 0.08);
}

.field-block {
  margin-top: 22rpx;
}

.section-title.compact {
  margin-bottom: 12rpx;
  font-size: 27rpx;
}

.scan-textarea {
  min-height: 260rpx;
}

.chip-grid,
.signal-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.choice-chip,
.signal-chip {
  display: flex;
  align-items: center;
  min-height: 58rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  border: 1rpx solid #d7dee8;
  background: #ffffff;
  color: #344054;
  font-size: 24rpx;
  box-sizing: border-box;
}

.choice-chip.active {
  border-color: #0f766e;
  background: #e6f4f1;
  color: #0f766e;
  font-weight: 700;
}

.signal-chip {
  width: calc(50% - 6rpx);
  justify-content: flex-start;
  padding: 0 16rpx;
}

.signal-chip.active {
  border-color: #b42318;
  background: #fff1f0;
  color: #b42318;
  font-weight: 700;
}

.signal-dot {
  width: 14rpx;
  height: 14rpx;
  margin-right: 10rpx;
  border-radius: 50%;
  background: #cbd5e1;
  flex: 0 0 14rpx;
}

.signal-chip.active .signal-dot {
  background: #f79009;
}

.example-card {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
  color: #344054;
  font-size: 25rpx;
  line-height: 1.55;
}

.example-card:last-child {
  border-bottom: 0;
}

.compact-case {
  margin-bottom: 18rpx;
}
