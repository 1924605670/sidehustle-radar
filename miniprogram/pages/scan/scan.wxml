<view class="page scan-page">
  <view class="scan-hero">
    <view class="hero-copy">
      <view class="eyebrow">风险检测工作台</view>
      <view class="hero-title">把副业广告拆成可核验信号</view>
      <view class="hero-subtitle">支持文案、项目名和红线自查。请勿粘贴身份证、银行卡、验证码等敏感信息。</view>
    </view>
    <image class="hero-image" src="/assets/scan-radar.png" mode="aspectFill" />
  </view>

  <view class="panel">
    <view class="segmented">
      <block wx:for="{{modes}}" wx:key="key">
        <view class="segmented-item {{activeMode === item.key ? 'active' : ''}}" data-mode="{{item.key}}" bindtap="switchMode">{{item.text}}</view>
      </block>
    </view>
    <view class="field-tip mode-tip">{{activeModeTip}}</view>

    <view class="field-block" wx:if="{{activeMode !== 'copy'}}">
      <view class="section-title compact">
        <text>项目名称</text>
        <text class="muted">可只填关键词</text>
      </view>
      <input class="input" placeholder="例如：AI副业课、短剧切片、无人直播" value="{{projectName}}" bindinput="onProjectInput" />
      <view class="field-tip">不确定项目名时，也可以直接跳过，先贴文案。</view>
    </view>

    <view class="field-block" wx:if="{{activeMode !== 'project'}}">
      <view class="section-title compact">
        <text>{{activeMode === 'checklist' ? '补充描述' : '粘贴文案'}}</text>
        <text class="muted">{{text.length}}/2000</text>
      </view>
      <textarea class="textarea scan-textarea" placeholder="粘贴你看到的副业广告、招聘话术或私聊内容..." value="{{text}}" bindinput="onTextInput" maxlength="2000" />
      <view class="field-tip">不要粘贴身份证、银行卡、验证码等敏感信息。</view>
    </view>

    <view class="field-block">
      <view class="section-title compact toggle-line" bindtap="toggleAdvanced">
        <text>补充线索（可选）</text>
        <text class="section-link">{{showAdvanced ? '收起' : '展开'}}</text>
      </view>
      <view wx:if="{{showAdvanced}}">
        <view class="advanced-block">
          <view class="section-title compact">
            <text>来源平台</text>
            <text class="muted">帮助判断场景</text>
          </view>
          <view class="chip-grid">
            <block wx:for="{{platforms}}" wx:key="key">
              <view class="choice-chip {{selectedPlatform === item.key ? 'active' : ''}}" data-platform="{{item.key}}" bindtap="selectPlatform">{{item.text}}</view>
            </block>
          </view>
        </view>

        <view class="advanced-block">
          <view class="section-title compact">
            <text>已出现的红线</text>
            <text class="muted">可多选</text>
          </view>
          <view class="signal-grid">
            <block wx:for="{{signalOptions}}" wx:key="key">
              <view class="signal-chip {{item.active ? 'active' : ''}}" data-key="{{item.key}}" bindtap="toggleSignal">
                <view class="signal-dot"></view>
                <text>{{item.text}}</text>
              </view>
            </block>
          </view>
        </view>
      </view>
    </view>

    <view class="inline-error" wx:if="{{formError}}">{{formError}}</view>

    <view class="button-row">
      <view class="ghost-button" bindtap="clearText">重置</view>
      <view class="primary-button {{submitting ? 'disabled-button' : ''}}" bindtap="scan">{{submitting ? '检测中' : '立即检测'}}</view>
    </view>
  </view>

  <view class="panel">
    <view class="section-title">示例文案</view>
    <block wx:for="{{examples}}" wx:key="*this">
      <view class="example-card" data-text="{{item}}" bindtap="useExample">
        <view class="example-text">{{item}}</view>
        <view class="example-action">填入</view>
      </view>
    </block>
  </view>

  <view class="section-title">
    <text>近期风险案例</text>
    <text class="muted" wx:if="{{loadingCases}}">加载中</text>
  </view>
  <block wx:for="{{latestCases}}" wx:key="id">
    <view class="case-card compact-case">
      <view class="card-title">{{item.title}}</view>
      <view class="meta-row">
        <text>{{item.source_label}}</text>
      </view>
      <view class="subtitle">{{item.summary}}</view>
      <view>
        <block wx:for="{{item.risk_points_preview}}" wx:key="*this">
          <view class="tag danger">{{item}}</view>
        </block>
      </view>
      <view class="source-copy" data-url="{{item.source_url}}" bindtap="copySource">复制公开来源链接</view>
    </view>
  </block>

  <view class="notice">
    检测结果只保存特征摘要，不保存原文。涉及转账、押金、下载陌生 App、银行卡或验证码时，先停止再核实。
  </view>
</view>
