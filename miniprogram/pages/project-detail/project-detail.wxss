.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-head .title {
  flex: 1;
}

.detail-decision {
  display: inline-flex;
  align-items: center;
  min-height: 54rpx;
  margin-top: 18rpx;
  padding: 0 18rpx;
  border-radius: 12rpx;
  background: rgba(255, 255, 255, 0.12);
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 800;
  box-sizing: border-box;
}

.detail-decision.high,
.detail-decision.extreme {
  background: rgba(255, 241, 240, 0.15);
}

.detail-decision.low {
  background: rgba(236, 253, 243, 0.15);
}

.takeaway {
  color: #182230;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
}

.source-copy {
  margin-top: 18rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.threshold-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.threshold-row:last-child {
  border-bottom: 0;
}

.threshold-label {
  flex: 0 0 100rpx;
  color: #667085;
  font-size: 25rpx;
}

.threshold-value {
  flex: 1;
  color: #182230;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: right;
}

.fit-group {
  margin-top: 16rpx;
}
