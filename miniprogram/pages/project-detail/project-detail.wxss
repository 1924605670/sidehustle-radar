.detail-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.detail-head .title {
  flex: 1;
}

.takeaway {
  color: #182230;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.55;
}

.source-copy {
  margin-top: 18rpx;
  color: #0f766e;
  font-size: 24rpx;
  font-weight: 700;
}

.threshold-row {
  display: flex;
  justify-content: space-between;
  gap: 24rpx;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #edf1f7;
}

.threshold-row:last-child {
  border-bottom: 0;
}

.threshold-label {
  flex: 0 0 100rpx;
  color: #667085;
  font-size: 25rpx;
}

.threshold-value {
  flex: 1;
  color: #182230;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.45;
  text-align: right;
}

.fit-group {
  margin-top: 16rpx;
}
