<view class="page">
  <view class="hero-panel">
    <view class="eyebrow">SIDEHUSTLE RADAR</view>
    <view class="title">副业避坑雷达</view>
    <view class="subtitle">看到副业、兼职、网赚广告，先查项目、看案例、再决定要不要投入时间和钱。</view>
    <view class="metric-grid">
      <view class="metric-item">
        <view class="metric-value">{{stats.projects}}</view>
        <view class="metric-label">收录项目</view>
      </view>
      <view class="metric-item">
        <view class="metric-value">{{stats.cases}}</view>
        <view class="metric-label">真实案例</view>
      </view>
      <view class="metric-item">
        <view class="metric-value">{{stats.highRisk}}</view>
        <view class="metric-label">高危方向</view>
      </view>
    </view>
  </view>

  <view class="panel">
    <view class="section-title">快速查询</view>
    <input class="input" placeholder="搜索：小说推文、刷单返利、无人直播" value="{{keyword}}" bindinput="onKeywordInput" confirm-type="search" bindconfirm="goSearch" />
    <view class="button-row">
      <view class="primary-button" bindtap="goSearch">查项目</view>
      <view class="secondary-button" bindtap="goScan">测文案</view>
    </view>
  </view>

  <view class="panel">
    <view class="section-title">热门查询</view>
    <view>
      <block wx:for="{{hotKeywords}}" wx:key="*this">
        <view class="tag" data-keyword="{{item}}" bindtap="searchTag">{{item}}</view>
      </block>
    </view>
  </view>

  <view class="section-block">
    <view class="section-title">
      <text>重点风险项目</text>
      <text class="muted" bindtap="goProjects">全部</text>
    </view>
    <block wx:for="{{topProjects}}" wx:key="id">
      <view class="project-card" data-slug="{{item.slug}}" bindtap="openProject">
        <view class="card-head">
          <view class="card-title">{{item.title}}</view>
          <view class="risk-pill {{item.risk_class}}">{{item.risk_level_text}}</view>
        </view>
        <view class="subtitle">{{item.summary}}</view>
        <view class="meta-row">
          <text>风险分 {{item.risk_score}}</text>
          <text wx:if="{{item.case_count}}">{{item.case_count}} 个案例</text>
        </view>
      </view>
    </block>
  </view>

  <view class="section-block" wx:if="{{latestCases.length}}">
    <view class="section-title">最新案例</view>
    <block wx:for="{{latestCases}}" wx:key="id">
      <view class="case-card">
        <view class="card-title">{{item.title}}</view>
        <view class="meta-row">
          <text>{{item.source_label}}</text>
        </view>
        <view class="subtitle">{{item.summary}}</view>
      </view>
    </block>
  </view>
</view>
