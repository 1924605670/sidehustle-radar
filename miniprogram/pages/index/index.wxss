.home-page {
  padding-top: 18rpx;
}

.home-hero {
  display: flex;
  align-items: stretch;
  min-height: 292rpx;
  padding: 30rpx 28rpx;
  margin-bottom: 18rpx;
  border-radius: 18rpx;
  background: #102a43;
  color: #ffffff;
  overflow: hidden;
  border: 1rpx solid rgba(255, 255, 255, 0.12);
  box-sizing: border-box;
}

.hero-copy {
  flex: 1;
  min-width: 0;
  padding-right: 18rpx;
}

.hero-title {
  font-size: 42rpx;
  font-weight: 800;
  line-height: 1.2;
}

.hero-subtitle {
  margin-top: 14rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 24rpx;
  line-height: 1.6;
}

.hero-proof {
  margin-top: 12rpx;
  color: #a7f3d0;
  font-size: 23rpx;
  font-weight: 700;
  line-height: 1.45;
}

.hero-image {
  width: 212rpx;
  height: 212rpx;
  flex: 0 0 212rpx;
  align-self: center;
  border-radius: 18rpx;
}

.trust-row {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-top: 18rpx;
}

.trust-chip {
  padding: 8rpx 14rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.1);
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
}

.compact-hero {
  padding-top: 18rpx;
  padding-bottom: 18rpx;
}

.compact-hero .metric-grid {
  margin-top: 0;
}

.action-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.compact-actions {
  margin-bottom: 0;
}

.action-card {
  min-height: 140rpx;
  padding: 22rpx 20rpx;
  border-radius: 16rpx;
  background: #ffffff;
  border: 1rpx solid #e4e9f2;
  box-shadow: 0 10rpx 28rpx rgba(15, 23, 42, 0.04);
  box-sizing: border-box;
}

.action-title,
.process-title {
  color: #101828;
  font-size: 28rpx;
  font-weight: 700;
}

.compact-title {
  margin-bottom: 12rpx;
  font-size: 27rpx;
}

.process-line {
  display: flex;
  align-items: flex-start;
  gap: 16rpx;
  padding: 12rpx 0;
}

.process-index {
  flex: 0 0 42rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 12rpx;
  background: #e6f4f1;
  color: #0f766e;
  font-size: 23rpx;
  font-weight: 800;
  line-height: 42rpx;
  text-align: center;
}

.process-copy {
  flex: 1;
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.plain-tag {
  margin: 0;
}

.project-card-strong {
  border-color: #f2d6ce;
}

.starter-card {
  border-color: #d6ebe5;
}

.compact-case .source-copy {
  margin-top: 16rpx;
}
