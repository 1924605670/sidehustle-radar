.library-page {
  padding-top: 18rpx;
}

.library-hero {
  margin-bottom: 18rpx;
}

.compact-title {
  margin-bottom: 12rpx;
  font-size: 27rpx;
}

.second-title {
  margin-top: 20rpx;
}

.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.filter-chip {
  min-height: 72rpx;
  padding: 0 22rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
  line-height: 72rpx;
}

.filter-chip.active {
  background: #0f766e;
  color: #ffffff;
}

.slim-row {
  margin-top: 14rpx;
}

.decision-banner {
  margin-top: 16rpx;
}

.card-topline {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.plain-tag {
  margin: 0;
}

.case-mini {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.case-mini-title {
  margin-top: 6rpx;
  color: #182230;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}
