.filter-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 20rpx;
}

.filter-chip {
  height: 58rpx;
  padding: 0 20rpx;
  border-radius: 12rpx;
  background: #f2f4f7;
  color: #475467;
  font-size: 24rpx;
  line-height: 58rpx;
}

.filter-chip.active {
  background: #0f766e;
  color: #ffffff;
}

.case-mini {
  margin-top: 18rpx;
  padding: 18rpx;
  border-radius: 14rpx;
  background: #f8fafc;
}

.case-mini-title {
  margin-top: 6rpx;
  color: #182230;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.45;
}
