page {
  background: #f6f7f9;
  color: #182230;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

.page {
  padding: 24rpx;
}

.panel {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(16, 24, 40, 0.05);
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #101828;
}

.subtitle {
  margin-top: 12rpx;
  color: #667085;
  font-size: 26rpx;
  line-height: 1.55;
}

.button {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  background: #0f766e;
  color: #ffffff;
  font-size: 30rpx;
  font-weight: 600;
}

.button.secondary {
  background: #e6f4f1;
  color: #0f766e;
}

.input {
  min-height: 84rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  padding: 0 24rpx;
  background: #ffffff;
  font-size: 28rpx;
}

.textarea {
  min-height: 280rpx;
  border: 2rpx solid #d0d5dd;
  border-radius: 12rpx;
  padding: 20rpx 24rpx;
  background: #ffffff;
  font-size: 28rpx;
  line-height: 1.55;
}

.tag {
  display: inline-flex;
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  margin: 8rpx 8rpx 0 0;
  background: #eef4ff;
  color: #175cd3;
  font-size: 24rpx;
}

.risk-low {
  color: #067647;
}

.risk-medium {
  color: #b54708;
}

.risk-high {
  color: #c4320a;
}

.risk-extreme {
  color: #b42318;
}

